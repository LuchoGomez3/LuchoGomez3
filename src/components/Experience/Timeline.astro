---
const EXPERIENCES = [
  {
    title: "Blumb AI",
    date: "Noviembre 1, 2025",
    latest: true,
    description:
      "En Blumb AI, me desempeño como FullStack Engineer especializado en soluciones de inteligencia artificial. Mi trabajo se centra en el desarrollo de aplicaciones innovadoras que integran modelos de IA avanzados, procesamiento de lenguaje natural, automatizaciones con n8n y aprendizaje automático. Colaboro en la construcción de productos que transforman la manera en que las empresas interactúan con la tecnología, aplicando las últimas tendencias en IA generativa y automatización inteligente para crear experiencias de usuario excepcionales.",
    link: "https://blumb.ai/",
    image: "/works/Blumb.jpeg",
  },
  {
    title: "YendoAr",
    date: "Marzo 1, 2024 - Octubre 30, 2025",
    latest: false,
    description:
      "En YendoAr, me desempeñé como desarrollador FullStack, integrándome en un equipo ágil para construir una plataforma web innovadora de carpooling. Mi trabajo incluyó la implementación de funcionalidades clave para la búsqueda y reserva de viajes en tiempo real, enfocándome en asegurar una interfaz de usuario intuitiva y de alto rendimiento. Además amplié mis conocimientos del lado del servidor como Backend Developer. Continuamente apliqué nuevas metodologías y tecnologías para optimizar los flujos de trabajo y la calidad del producto.",
    link: "https://yendoar.com/",
    image: "/works/Yendo-logo.png",
  },
  {
    title: "Checkbox Innovations",
    date: "Octubre 15, 2023 - Febrero 28, 2025",
    latest: false,
    description:
      "Mi experiencia en Checkbox Innovations marcó una transición clave de trainee a desarrollador FullStack Junior, proporcionándome una comprensión profunda del ciclo de vida del desarrollo de software en un entorno profesional. Colaboré en múltiples proyectos, donde apliqué y fortifiqué mis conocimientos en React, FastApi, Postgresql, Docker y en prácticas de desarrollo ágil. Esta etapa fue fundamental para mi crecimiento y autonomía como profesional.",
    link: "https://checkboxinnovations.com/",
    image: "/works/checkboxinnovations-logo.jpeg",
  },
];
---

<ol
  class="relative border-s border-gray-300 dark:border-gray-600 px-4 sm:px-6 lg:px-8"
>
  {
    EXPERIENCES.map((experience) => (
      <li class="mb-10 ms-6">
        <span class="absolute flex items-center justify-center w-6 h-6 bg-blue-100 rounded-full -start-3 ring-8 ring-white dark:ring-gray-900 dark:bg-blue-900">
          <svg
            class="w-2.5 h-2.5 text-blue-600 dark:text-blue-300"
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path d="M20 4a2 2 0 0 0-2-2h-2V1a1 1 0 0 0-2 0v1h-3V1a1 1 0 0 0-2 0v1H6V1a1 1 0 0 0-2 0v1H2a2 2 0 0 0-2 2v2h20V4ZM0 18a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8H0v10Zm5-8h10a1 1 0 0 1 0 2H5a1 1 0 0 1 0-2Z" />
          </svg>
        </span>
        <h3 class="flex items-center mb-1 text-base sm:text-lg font-semibold text-gray-900 dark:text-white">
          {experience.title}
          {experience.latest && (
            <span class="latest-badge text-xs sm:text-sm font-medium px-3 py-1 rounded-full ms-3">
              Latest
            </span>
          )}
        </h3>
        <time class="block mb-2 text-xs sm:text-sm font-normal leading-none text-gray-500 dark:text-gray-400">
          {experience.date}
        </time>
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
          <p class="mb-4 text-base font-normal text-gray-600 dark:text-gray-300">
            {experience.description}
          </p>
          <img
            id="experience-img"
            src={experience.image}
            alt={experience.title}
            class="w-full sm:w-[150px] md:w-[200px] rounded-lg object-cover border-2 border-gray-200 dark:border-gray-700 shadow-md hover:shadow-xl transition-shadow duration-300"
          />
        </div>
      </li>
    ))
  }
</ol>

<script>
  import "./exp.js";
</script>

<style>
  .latest-badge {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: white;
    box-shadow: 0 2px 8px rgba(16, 185, 129, 0.3);
  }

  .dark .latest-badge {
    background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
    color: #0f172a;
    box-shadow: 0 2px 8px rgba(52, 211, 153, 0.4);
  }
</style>
